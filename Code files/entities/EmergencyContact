{
  "name": "EmergencyContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name"
    },
    "relationship": {
      "type": "string",
      "description": "Relationship to user"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sos_alerts",
          "arrival_notifications",
          "guardian_trips",
          "abnormal_alerts"
        ]
      },
      "description": "Allowed notification permissions"
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the primary emergency contact"
    }
  },
  "required": [
    "name",
    "relationship"
  ]
}